# Copy to deploy/.env and fill in real values (gitignored)

# Yandex Cloud folder ID
YC_FOLDER_ID="your-folder-id"

# API Gateway ID (existing gateway to update)
YAC_AGW_ID="your-agw-id"

# Custom domain attached to the AGW
AGW_DOMAIN="your-domain.example.com"

# Public IP of the server running the adapter + decoy nginx
POD_IP="1.2.3.4"

# CF → adapter wakeup base URL
# Must match: https://<AGW_DOMAIN>/<wakeup-path-prefix>
YAC_ORIGIN_BASE="https://your-domain.example.com/api/hassio/ws"

# Optional overrides:
# YAC_FUNCTION_NAME="hass-ws-relay"
# YAC_SA_NAME="hass-relay-sa"
# YAC_BRIDGE_SECRET="override-auto-generated-secret"
